{
  "version": "0.2.0",
  "configurations": [
      {
          "type": "java",
          "name": "Run EduTool (auto JavaFX version)",
          "request": "launch",
          "mainClass": "erudition_program.MainApp",
          "projectName": "erudition_ai",
          "cwd": "${workspaceFolder}",
          "preLaunchTask": "Set JavaFX env",
          "envFile": "${workspaceFolder}/.jfx.env",
          "vmArgs": [
              "--module-path", "${env:JFX_MODULE_PATH}",
              "--add-modules", "javafx.controls",
              "--enable-native-access=javafx.graphics",
              "--enable-native-access=ALL-UNNAMED",
              "-Dnative.dir=${workspaceFolder}/native/build/Release"
          ],
          "classPaths": [
              "${workspaceFolder}/target/classes"
          ]
      }
  ]
}